# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# ── Application ─────────────────────────────────────────────
APP_ENV=production
APP_TIMEZONE=UTC
APP_MODE=DRY_RUN
# APP_MODE: LIVE | DRY_RUN
LOG_LEVEL=debug
# LOG_LEVEL: debug|info|notice|warning|error|critical|alert|emergency

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
# Comma-separated numeric Telegram user IDs allowed to use the admin panel
TELEGRAM_ADMIN_IDS=

# ── Database (MySQL / MariaDB) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signal_bot
DB_USERNAME=signal_bot
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ── Binance ──────────────────────────────────────────────────
BINANCE_ENABLED=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443

# ── MEXC ─────────────────────────────────────────────────────
MEXC_ENABLED=true
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_REST_BASE=https://api.mexc.com
MEXC_WS_BASE=wss://wbs.mexc.com/ws

# ── Wallex ───────────────────────────────────────────────────
WALLEX_ENABLED=true
WALLEX_API_KEY=
WALLEX_API_SECRET=
WALLEX_REST_BASE=https://api.wallex.ir
WALLEX_WS_BASE=wss://api.wallex.ir/socket.io

# ── Scanner defaults (mirrored into bot_settings on first boot) ──
SCAN_SYMBOL_LIMIT=200
SCAN_INTERVAL=60
MIN_VOLUME=100000
MIN_LIQUIDITY=50000
MIN_SIGNAL_SCORE=75
SIGNAL_COOLDOWN=1800
