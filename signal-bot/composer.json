{
    "name": "nikto/telegram-signal-bot",
    "description": "Production-ready autonomous crypto market scanner and Telegram signal bot.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "react/event-loop": "^1.5",
        "react/socket": "^1.15",
        "react/http": "^1.11",
        "react/promise": "^3.2",
        "react/async": "^4.3",
        "ratchet/pawl": "^0.4.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=6"
    }
}
