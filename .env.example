# Copy this file to .env and fill in real values. Never commit .env.

# -- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs allowed into the admin panel.
ADMIN_IDS=

# -- Storage (SQLite — a single file in a self-created, self-protected
#    folder next to these 4 files; no separate database server needed) ------
# STORAGE_DIR=./storage
# DB_FILE=database.sqlite

# -- Binance -----------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443

# -- MEXC ----------------------------------------------------------------
MEXC_API_KEY=
MEXC_API_SECRET=
MEXC_REST_BASE=https://api.mexc.com
MEXC_WS_BASE=wss://wbs.mexc.com

# -- Wallex --------------------------------------------------------------
WALLEX_API_KEY=
WALLEX_REST_BASE=https://api.wallex.ir

# Comma-separated, priority order.
ENABLED_EXCHANGES=binance,mexc,wallex

# -- Scanner -------------------------------------------------------------
SCANNER_TOP_N=200
SCANNER_INTERVAL_SECONDS=3600
MIN_VOLUME_USDT=1000000
MAX_SPREAD_PERCENT=0.5
ALLOWED_QUOTE_ASSETS=USDT
INCLUDE_STABLECOIN_PAIRS=false

# -- Timeframes ------------------------------------------------------------
TIMEFRAMES=1m,5m,15m,1h,4h,1D

# -- Signal thresholds -------------------------------------------------------
MIN_SIGNAL_SCORE=75
SIGNAL_COOLDOWN_SECONDS=1800
MIN_RISK_REWARD=1.5

# -- Confluence weights (optional overrides) ----------------------------------
# WEIGHT_TREND=20
# WEIGHT_SUPPORT=15
# WEIGHT_RESISTANCE=15
# WEIGHT_ORDER_BLOCK=20
# WEIGHT_FVG=15
# WEIGHT_VOLUME=10
# WEIGHT_INDICATORS=5

# -- Runtime ---------------------------------------------------------------
# LIVE or DRY_RUN. Always start with DRY_RUN.
RUN_MODE=DRY_RUN

# 'cron' (default): worker.php runs one bounded pass and exits — set up a
#   cPanel Cron Job to run it every 1 minute (cPanel's minimum interval).
#   This is the only mode plain shared hosting (no SSH, no persistent
#   process) can actually run.
# 'daemon': worker.php loops forever until stopped — only if your host lets
#   you keep a background process alive (SSH + nohup/screen, a VPS, etc).
WORKER_MODE=cron
WORKER_MAX_RUNTIME_SECONDS=50

WORKER_TICK_SECONDS=15
HTTP_TIMEOUT_SECONDS=10
MAX_RETRIES=5
APP_TIMEZONE=UTC
